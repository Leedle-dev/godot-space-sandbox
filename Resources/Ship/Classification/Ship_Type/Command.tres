[resource]
script = ExtResource("1_xt4aj")
description = "Command ships are the heart of any squadron. They safely transport large amounts of smaller ships, and offer reinforcements in the midst of battle. They have a good balance of defensive firepower, shielding, and maneuverability. "
shipType = "Command"
